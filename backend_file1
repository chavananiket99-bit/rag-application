import re
from datetime import date


MONTHS = {
    "january": 1,
    "february": 2,
    "march": 3,
    "april": 4,
    "may": 5,
    "june": 6,
    "july": 7,
    "august": 8,
    "september": 9,
    "october": 10,
    "november": 11,
    "december": 12,
}

DATE_PATTERN = (
    r"(?P<day>\d{1,2})\s*(?:st|nd|rd|th)?\s*"
    r"(?P<month>january|february|march|april|may|june|july|august|"
    r"september|october|november|december)\s*[,\-]?\s*"
    r"(?P<year>\d{4})"
)

EXPIRY_PATTERNS = [
    re.compile(
        rf"(?:valid\s*(?:up\s*to|until|till)|"
        rf"(?:will|shall)\s*expire\s*on|expires?\s*on|"
        rf"expiry\s*date\s*(?:is|:)?)\s*{DATE_PATTERN}",
        re.IGNORECASE,
    ),
    re.compile(
        rf"(?:agreement\s+)?(?:is\s+)?valid\s+from\s+{DATE_PATTERN}"
        rf".{{0,80}}?\b(?:to|until|till)\s+"
        rf"(?P<end_day>\d{{1,2}})\s*(?:st|nd|rd|th)?\s*"
        rf"(?P<end_month>january|february|march|april|may|june|july|august|"
        rf"september|october|november|december)\s*[,\-]?\s*"
        rf"(?P<end_year>\d{{4}})",
        re.IGNORECASE,
    ),
    re.compile(
        rf"(?:agreement\s+)?(?:is\s+)?valid\s+for.{{0,100}}?"
        rf"effective\s+from\s+{DATE_PATTERN}.{{0,80}}?"
        rf"(?:to|valid\s*(?:up\s*to|until|till))\s+"
        rf"(?P<end_day>\d{{1,2}})\s*(?:st|nd|rd|th)?\s*"
        rf"(?P<end_month>january|february|march|april|may|june|july|august|"
        rf"september|october|november|december)\s*[,\-]?\s*"
        rf"(?P<end_year>\d{{4}})",
        re.IGNORECASE,
    ),
]


def _date_from_match(match):
    day = match.groupdict().get("end_day") or match.group("day")
    month = match.groupdict().get("end_month") or match.group("month")
    year = match.groupdict().get("end_year") or match.group("year")

    try:
        return date(
            int(year),
            MONTHS[month.lower()],
            int(day),
        )
    except (KeyError, TypeError, ValueError):
        return None


def extract_agreement_expiry(text):
    if not text:
        return None

    normalized_text = re.sub(
        r"\s+",
        " ",
        str(text).replace("\u00a0", " "),
    )
    candidates = []

    for pattern in EXPIRY_PATTERNS:
        for match in pattern.finditer(normalized_text):
            parsed_date = _date_from_match(match)
            if parsed_date:
                candidates.append(parsed_date)

    if not candidates:
        return None

    return max(candidates).isoformat()

