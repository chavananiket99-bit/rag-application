import { useState } from "react";
import { Send, Loader2 } from "lucide-react";
export default function ChatInput({
 onSend,
 disabled = false,
}) {
 const [input, setInput] = useState("");
 const handleSubmit = async (event) => {
   event.preventDefault();
   const message = input.trim();
   if (!message || disabled) {
     return;
   }
   setInput("");
   try {
     await onSend(message);
   } catch (error) {
     console.error("Failed to send message:", error);
     /*
      * If sending fails, restore the user's message
      * so they don't lose what they typed.
      */
     setInput(message);
   }
 };
 const handleKeyDown = (event) => {
   if (event.key === "Enter" && !event.shiftKey) {
     event.preventDefault();
     handleSubmit(event);
   }
 };
 return (
<form
     onSubmit={handleSubmit}
     className="border-t border-slate-800 bg-slate-950/95 px-4 py-3 sm:px-6"
>
<div className="mx-auto flex max-w-4xl items-end gap-2 rounded-2xl border border-slate-800 bg-slate-900/70 p-2 shadow-lg">
<textarea
         value={input}
         onChange={(event) => setInput(event.target.value)}
         onKeyDown={handleKeyDown}
         disabled={disabled}
         rows={1}
         placeholder={
           disabled
             ? "AI is responding..."
             : "Ask something about your documents..."
         }
         className="max-h-32 min-h-[42px] flex-1 resize-none bg-transparent px-3 py-2.5 text-sm text-slate-200 outline-none placeholder:text-slate-600 disabled:cursor-not-allowed disabled:opacity-60"
       />
<button
         type="submit"
         disabled={disabled || !input.trim()}
         className="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-red-700 text-white transition hover:bg-red-600 disabled:cursor-not-allowed disabled:bg-slate-800 disabled:text-slate-600"
         aria-label="Send message"
         title="Send message"
>
         {disabled ? (
<Loader2 size={17} className="animate-spin" />
         ) : (
<Send size={17} />
         )}
</button>
</div>
<p className="mx-auto mt-2 max-w-4xl text-center text-[10px] text-slate-700">
       Press Enter to send · Shift + Enter for a new line
</p>
</form>
 );
}
