/* =============================================================
   STAT CARD
============================================================= */

function StatCard({
  label,
  value,
  description,
  icon: Icon,
  iconClass,
  onClick,
}) {
  const Component = onClick ? "button" : "div";

  return (
    <Component
      type={onClick ? "button" : undefined}
      onClick={onClick}
      className={`enterprise-card p-5 text-left transition duration-200 hover:-translate-y-0.5 hover:shadow-md ${onClick ? "cursor-pointer focus:outline-none focus:ring-2 focus:ring-red-200" : ""}`}
    >
      <div className="flex items-start justify-between gap-4">
        <div className="min-w-0">
          <p className="text-xs font-medium uppercase tracking-wider text-slate-400">
            {label}
          </p>

          <p className="mt-2 truncate text-2xl font-semibold text-slate-800 sm:text-3xl">
            {value}
          </p>

          <p className="mt-1 text-xs text-slate-500">{description}</p>
        </div>

        <div
          className={`flex h-11 w-11 shrink-0 items-center justify-center rounded-xl ${iconClass}`}
        >
          <Icon size={21} />
        </div>
      </div>
    </Component>
  );
}

function AgreementViewButton({ active, onClick, children }) {
  return (
    <button
      type="button"
      onClick={onClick}
      className={`rounded-md px-3 py-2 text-xs font-semibold transition ${
        active
          ? "bg-white text-slate-900 shadow-sm"
          : "text-slate-500 hover:text-slate-800"
      }`}
    >
      {children}
    </button>
  );
}

function AgreementList({ agreements, view }) {
  const expired = view === "expired";

  if (agreements.length === 0) {
    return (
      <div className="px-5 py-10 text-center">
        <CheckCircle2 size={24} className="mx-auto text-emerald-600" />
        <p className="mt-2 text-sm font-medium text-slate-700">
          No {view === "active" ? "active" : expired ? "expired" : "nearing-expiry"} agreements
        </p>
      </div>
    );
  }

  return (
    <div className="divide-y divide-slate-100">
      {agreements.map((agreement) => {
        const daysRemaining = getDaysUntilExpiry(agreement.expiryDate);
        const urgency = expired
          ? `Expired ${Math.abs(daysRemaining)} day${Math.abs(daysRemaining) === 1 ? "" : "s"} ago`
          : daysRemaining === 0
            ? "Expires today"
            : `${daysRemaining} day${daysRemaining === 1 ? "" : "s"} remaining`;

        return (
          <div
            key={agreement.id}
            className="flex items-start gap-3 px-5 py-4"
          >
            <div
              className={`flex h-10 w-10 shrink-0 items-center justify-center rounded-lg ${expired ? "bg-red-50" : "bg-amber-50"}`}
            >
              {expired ? (
                <XCircle size={19} className="text-red-700" />
              ) : (
                <AlertTriangle size={19} className="text-amber-700" />
              )}
            </div>
            <div className="min-w-0 flex-1">
              <p className="truncate text-sm font-medium text-slate-800">
                {agreement.filename}
              </p>
              <p className="mt-0.5 text-xs text-slate-500">
                Expiry: {formatExpiryDate(agreement.expiryDate)}
              </p>
              <p className="mt-1 text-xs leading-5 text-slate-400">
                {agreement.analysis?.start_date
                  ? `Start: ${formatExpiryDate(agreement.analysis.start_date)} · `
                  : ""}
                {agreement.analysis?.transaction_type || "Type not classified"}
                {agreement.analysis?.signature_status
                  ? ` · ${agreement.analysis.signature_status}`
                  : ""}
              </p>
            </div>
            <span
              className={`shrink-0 text-right text-xs font-semibold ${expired ? "text-red-700" : "text-amber-700"}`}
            >
              {urgency}
            </span>
          </div>
        );
      })}
    </div>
  );
}

function formatExpiryDate(expiryDate) {
  return new Intl.DateTimeFormat("en-IN", {
    day: "2-digit",
    month: "short",
    year: "numeric",
  }).format(new Date(`${expiryDate}T00:00:00`));
}

function ComplianceMetric({ label, value, description, tone }) {
  const toneClass = {
    amber: "text-amber-700",
    emerald: "text-emerald-700",
    slate: "text-slate-700",
  }[tone];

  return (
    <div className="bg-white px-5 py-4">
      <p className="text-xs font-medium uppercase tracking-wider text-slate-400">
        {label}
      </p>
      <p className={`mt-2 text-2xl font-semibold ${toneClass}`}>{value}</p>
      <p className="mt-1 text-xs text-slate-500">{description}</p>
    </div>
  );
}

