import { useState } from "react";
import {
 Bot,
 User,
 Copy,
 Check,
 ChevronDown,
 ChevronRight,
 RefreshCw,
 AlertCircle,
 FileText,
} from "lucide-react";
export default function MessageBubble({
 sender,
 text,
 sources = [],
 isError = false,
 onRetry,
}) {
 const [copied, setCopied] = useState(false);
 const [sourcesOpen, setSourcesOpen] = useState(false);
 const isUser = sender === "user";
 const handleCopy = async () => {
   if (!text) return;
   try {
     await navigator.clipboard.writeText(text);
     setCopied(true);
     setTimeout(() => {
       setCopied(false);
     }, 1800);
   } catch (error) {
     console.error("Failed to copy answer:", error);
   }
 };
 /*
  * =========================================================
  * USER MESSAGE
  * =========================================================
  */
 if (isUser) {
   return (
<div className="flex justify-end">
<div className="flex max-w-[85%] items-start gap-3 sm:max-w-[75%]">
         {/* User message */}
<div className="rounded-2xl rounded-tr-md bg-red-700 px-4 py-3 text-sm leading-6 text-white shadow-sm">
           {text}
</div>
         {/* User icon */}
<div className="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-slate-200 bg-slate-100">
<User size={15} className="text-slate-600" />
</div>
</div>
</div>
   );
 }
 /*
  * =========================================================
  * ASSISTANT MESSAGE
  * =========================================================
  */
 return (
<div className="flex items-start gap-3">
     {/* =====================================================
         AI ICON
     ====================================================== */}
<div
       className={`flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border ${
         isError
           ? "border-red-200 bg-red-50"
           : "border-red-100 bg-red-50"
       }`}
>
       {isError ? (
<AlertCircle size={15} className="text-red-600" />
       ) : (
<Bot size={15} className="text-red-700" />
       )}
</div>
     {/* =====================================================
         MESSAGE CONTENT
     ====================================================== */}
<div className="min-w-0 max-w-[85%] sm:max-w-[80%]">
<div
         className={`rounded-2xl rounded-tl-md border px-4 py-3 shadow-sm ${
           isError
             ? "border-red-200 bg-red-50"
             : "border-slate-200 bg-white"
         }`}
>
         {/* Answer */}
<div
           className={`whitespace-pre-wrap text-sm leading-6 ${
             isError ? "text-red-700" : "text-slate-700"
           }`}
>
           {text}
</div>
         {/* =================================================
             COPY
         ================================================== */}
         {!isError && text && (
<div className="mt-3 flex items-center gap-1 border-t border-slate-100 pt-2">
<button
               type="button"
               onClick={handleCopy}
               className="flex items-center gap-1.5 rounded-lg px-2 py-1.5 text-[11px] text-slate-500 transition hover:bg-slate-50 hover:text-slate-700"
               title="Copy answer"
>
               {copied ? (
<>
<Check size={13} />
<span>Copied</span>
</>
               ) : (
<>
<Copy size={13} />
<span>Copy</span>
</>
               )}
</button>
</div>
         )}
         {/* =================================================
             RETRY
         ================================================== */}
         {isError && onRetry && (
<div className="mt-3 border-t border-red-200 pt-3">
<button
               type="button"
               onClick={onRetry}
               className="flex items-center gap-2 rounded-lg border border-red-200 px-3 py-2 text-xs font-medium text-red-600 transition hover:bg-red-100 hover:text-red-700"
>
<RefreshCw size={13} />
               Try again
</button>
</div>
         )}
</div>
       {/* ===================================================
           SOURCES
       ==================================================== */}
       {!isError && sources.length > 0 && (
<div className="mt-2">
           {/* Source toggle */}
<button
             type="button"
             onClick={() =>
               setSourcesOpen((open) => !open)
             }
             className="flex items-center gap-1.5 rounded-lg px-2 py-1.5 text-[11px] font-medium text-slate-500 transition hover:bg-slate-100 hover:text-slate-700"
>
             {sourcesOpen ? (
<ChevronDown size={13} />
             ) : (
<ChevronRight size={13} />
             )}
<FileText
               size={13}
               className="text-red-600"
             />
<span>
               Sources ({sources.length})
</span>
</button>
           {/* Source list */}
           {sourcesOpen && (
<div className="mt-2 space-y-2">
               {sources.map((source, index) => {
                 const filename =
                   source?.filename ||
                   source?.file_name ||
                   source?.name ||
                   `Source ${index + 1}`;
                 const pageNumber =
                   source?.page_number ??
                   source?.page ??
                   null;
                 const chunkIndex =
                   source?.chunk_index ??
                   source?.chunk ??
                   null;
                 const preview =
                   source?.text ||
                   source?.content ||
                   source?.preview ||
                   "";
                 return (
<div
                     key={
                       source?.id ||
                       `${filename}-${chunkIndex}-${index}`
                     }
                     className="rounded-xl border border-slate-200 bg-slate-50 p-3 transition hover:border-slate-300 hover:bg-white"
>
                     {/* Source header */}
<div className="flex items-start gap-2.5">
<div className="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-red-50">
<FileText
                           size={14}
                           className="text-red-600"
                         />
</div>
<div className="min-w-0 flex-1">
<p
                           className="break-words text-xs font-semibold text-slate-700"
                           title={filename}
>
                           {filename}
</p>
                         {/* Metadata */}
                         {(pageNumber !== null ||
                           chunkIndex !== null) && (
<div className="mt-1.5 flex flex-wrap items-center gap-x-2 gap-y-1 text-[10px] text-slate-400">
                             {pageNumber !== null && (
<span>
                                 Page {pageNumber}
</span>
                             )}
                             {pageNumber !== null &&
                               chunkIndex !== null && (
<span className="text-slate-300">
                                   •
</span>
                               )}
                             {chunkIndex !== null && (
<span>
                                 Chunk {chunkIndex}
</span>
                             )}
</div>
                         )}
</div>
                       {/* Source number */}
<span className="shrink-0 rounded-md bg-white px-1.5 py-0.5 text-[9px] font-medium text-slate-400">
                         #{index + 1}
</span>
</div>
                     {/* Evidence */}
                     {preview && (
<div className="mt-3 border-t border-slate-200 pt-2.5">
<p className="mb-1 text-[10px] font-semibold uppercase tracking-wide text-slate-400">
                           Evidence
</p>
<p className="line-clamp-4 text-[11px] leading-5 text-slate-500">
                           {preview}
</p>
</div>
                     )}
</div>
                 );
               })}
</div>
           )}
</div>
       )}
</div>
</div>
 );
}
