import fitz
from rapidocr_onnxruntime import RapidOCR
import os
import logging

engine = RapidOCR()
logger = logging.getLogger("uvicorn.error")


def read_scanned_pdf(pdf_path):
   doc = fitz.open(pdf_path)
   # Initialize before the loop
   full_text = ""
   for page_num in range(len(doc)):
       page = doc.load_page(page_num)
       pix = page.get_pixmap(dpi=150)
       image_path = f"temp_page_{page_num}.png"
       pix.save(image_path)
       result, _ = engine(image_path)
       page_text = ""
       if result:
           for item in result:
               page_text += item[1] + " "
       logger.info("--- OCR Page %s ---", page_num + 1)
       logger.info("%s", page_text if page_text.strip() else "[No OCR text on this page]")

       full_text += page_text + "\n"
       if os.path.exists(image_path):
           os.remove(image_path)
   return full_text

//backend / pdf_reader.py
from pypdf import PdfReader
import logging


logger = logging.getLogger("uvicorn.error")

def read_pdf(file_path):
    reader = PdfReader(file_path)

    logger.info("Total pages in PDF: %s", len(reader.pages))

    text = ""

    for i, page in enumerate(reader.pages):
        page_text = page.extract_text()
        logger.info("--- Page %s ---", i + 1)
        if page_text and page_text.strip():
            logger.info("%s", page_text)
        else:
            logger.info("[No extractable text on this page]")
        
        if page_text:
            text += page_text + "\n"

    return text

